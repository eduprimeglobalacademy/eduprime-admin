# Supabase project — safe to expose to the browser (VITE_ prefix), scoped by RLS.
# Same Supabase project as the main test.eduprime app — this is the
# platform-staff console, a separate deployment, not a separate database.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Root domain org subdomains live under (used to build "view as" handoff URLs).
VITE_ROOT_DOMAIN=eduprime.app
